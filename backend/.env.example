PORT=3000

# PostgreSQL (TypeORM DataSource — backend/src/database/data-source.ts)
# Must match the credentials in the repo-root .env used by docker-compose.yml
# (POSTGRES_HOST is not needed there since the app connects over the host
# network to the container's published port).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=srp_db

# JWT (research.md #7, #11)
JWT_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS allow-list (research.md #7) — comma-separated origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Initial-password invite token (research.md #10)
INVITE_TOKEN_EXPIRES_IN=24h
