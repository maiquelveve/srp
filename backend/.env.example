PORT=3000

# PostgreSQL (TypeORM DataSource — backend/src/database/data-source.ts)
# Must match the credentials in the repo-root .env used by docker-compose.yml
# (POSTGRES_HOST is not needed there since the app connects over the host
# network to the container's published port).
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=srp_db

# JWT (research.md #7, #11)
JWT_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# CORS allow-list (research.md #7) — comma-separated origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Initial-password invite token (research.md #10)
INVITE_TOKEN_EXPIRES_IN=24h

# SMTP — e-mail de senha inicial/reset (research.md #6, feature 002)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@srp.rs.gov.br

# Biblioteca de documentos — armazenamento em disco local (research.md #4, #8, feature 002)
DOCUMENTS_STORAGE_PATH=./storage/documents
DOCUMENTS_MAX_FILE_SIZE_MB=10

# Rate limit per client IP (defaults: 100 requests / 60000 ms). Raise ONLY for load tests
# (test/load/shift-change.js), where k6 sends every request from a single IP.
# THROTTLE_LIMIT=100
# THROTTLE_TTL_MS=60000
# Login attempts per client IP per minute (default 5, brute-force guard). Raise ONLY for load tests.
# THROTTLE_LOGIN_LIMIT=5

# Base de conhecimento com IA (feature 003). Todos opcionais: os padrões servem para Ollama local.
# Qual provedor usa cada função. Embeddings: ollama | openai. Chat: ollama | openai | claude.
# AVISO: openai e claude enviam perguntas e trechos de documentos a terceiros.
EMBEDDING_PROVIDER=ollama
CHAT_PROVIDER=ollama
# Tamanho do vetor de embedding. DEVE ser igual ao da coluna vector(N) do banco (migration).
# Trocar o valor exige nova migration e reprocessar todos os documentos.
EMBEDDING_DIMENSIONS=1024
# AI_EMBEDDING_TIMEOUT_MS=30000
# AI_CHAT_TIMEOUT_MS=60000
# AI_EMBEDDING_BATCH_SIZE=16

# Ollama local (docker/ollama). Os nomes dos modelos devem ser os mesmos baixados pelo compose.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
# Janela de contexto do chat. O padrão do Ollama é pequeno e cortaria os trechos em silêncio.
OLLAMA_CHAT_NUM_CTX=8192

# OpenAI (obrigatório só se algum provedor for "openai")
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini

# Claude (obrigatório só se CHAT_PROVIDER=claude)
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_CHAT_MODEL=claude-sonnet-5-5

# Armazenamento dos arquivos da base de conhecimento e regras de consulta
KNOWLEDGE_STORAGE_PATH=./storage/knowledge
# Nota mínima (0 a 1) para um trecho valer como relevante; calibrar com perguntas reais.
KNOWLEDGE_MIN_SIMILARITY=0.45
# Consultas por usuário por minuto
KNOWLEDGE_QUERY_RATE_LIMIT=10
KNOWLEDGE_QUESTION_MAX_LENGTH=1000
