# Usado pelo docker-compose.yml do Ollama local (somente desenvolvimento).
# Copie para .env (ignorado pelo git) se quiser trocar algum valor; os
# defaults do compose já funcionam sem este arquivo.
#
# Estes nomes de modelo precisam ser os mesmos de OLLAMA_EMBEDDING_MODEL e
# OLLAMA_CHAT_MODEL em backend/.env (o compose baixa; o backend usa).
OLLAMA_PORT=11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct
